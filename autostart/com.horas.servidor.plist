<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  macOS (launchd). Troque SEU_USUARIO e, se precisar, o caminho do python3
  (Homebrew: /opt/homebrew/bin/python3). Instalar:
    cp autostart/com.horas.servidor.plist ~/Library/LaunchAgents/
    launchctl load ~/Library/LaunchAgents/com.horas.servidor.plist
  A pasta fica fora de Documentos, Mesa e Downloads: o macOS bloqueia, sem
  aviso, programas iniciados pelo launchd de ler essas pastas.
-->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.horas.servidor</string>
  <key>ProgramArguments</key>
  <array>
    <string>/usr/bin/python3</string>
    <string>/Users/SEU_USUARIO/horas/servidor.py</string>
  </array>
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <dict>
    <key>SuccessfulExit</key>
    <false/>
  </dict>
</dict>
</plist>
